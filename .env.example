# Server Configuration
PORT=3000
NODE_ENV=development

# Qdrant Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=semantic-layer

# Enrichment LLM Configuration
ENRICHMENT_LLM_API_KEY=
ENRICHMENT_LLM_BASE_URL=http://localhost:11434/v1
ENRICHMENT_LLM_MODEL=qwen2.5-coder:7b-instruct

# Answer LLM Configuration
ANSWER_LLM_API_KEY=
ANSWER_LLM_BASE_URL=http://localhost:11434/v1
ANSWER_LLM_MODEL=qwen2.5-coder:7b-instruct

# Embedding Configuration
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
