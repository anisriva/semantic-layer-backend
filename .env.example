# Server Configuration
app.server.port=3000
app.server.nodeEnv=development

# Worker Configuration
app.worker.pollIntervalMs=5000
app.worker.heartbeatIntervalMs=30000
app.worker.staleAfterMs=300000
app.worker.maxRetries=3

# Qdrant Configuration
app.ragDb.qdrant.url=http://localhost:6333
app.ragDb.qdrant.collectionPrefix=semantic-layer

# PostgreSQL Configuration
app.appDb.postgres.connectionString=postgresql://semantic_user:semantic_password@localhost:5432/semantic_layer

# ENRICHMENT LLM Configuration (Model-agnostic)
# Supports OpenAI, Ollama, or any OpenAI-compatible endpoint
# For OAuth2 providers (e.g., Gemma), configure oauth2 fields instead of apiKey
# Option 1: Ollama (local, no auth)
models.enrichment.apiKey=
models.enrichment.baseUrl=http://localhost:11434/v1
models.enrichment.model=qwen2.5-coder:7b-instruct
models.enrichment.maxRetries=2
models.enrichment.retryDelayMs=1000
models.enrichment.timeout=120000
# Option 2: Groq (API key auth)
# models.enrichment.apiKey=your-groq-api-key
# models.enrichment.baseUrl=https://api.groq.com/openai/v1
# models.enrichment.model=qwen/qwen3.8-27b
# Option 3: Gemma (OAuth2 auth)
# models.enrichment.baseUrl=https://api-int-hawkeye-dev.carbon.lowes.com/gemma4/v1
# models.enrichment.model=google/gemma-4-31B-it
# models.enrichment.oauth2.oauthUrl=https://api-int-hawkeye-dev.carbon.lowes.com/v1/oauthprovider/oauth2/token
# models.enrichment.oauth2.clientId=your-client-id
# models.enrichment.oauth2.clientSecret=your-client-secret

# ANSWER LLM Configuration (Model-agnostic)
# Supports OpenAI, Ollama, or any OpenAI-compatible endpoint
# For OAuth2 providers (e.g., Gemma), configure oauth2 fields instead of apiKey
models.answer.apiKey=
models.answer.baseUrl=http://localhost:11434/v1
models.answer.model=qwen2.5-coder:7b-instruct
models.answer.maxRetries=2
models.answer.retryDelayMs=1000
models.answer.timeout=120000
# OAuth2 Configuration (optional - for providers like Gemma)
# models.answer.oauth2.oauthUrl=https://api-int-hawkeye-dev.carbon.lowes.com/v1/oauthprovider/oauth2/token
# models.answer.oauth2.clientId=your-client-id
# models.answer.oauth2.clientSecret=your-client-secret

# Embedding Configuration (Model-agnostic)
# Supports OpenAI, Ollama, or any OpenAI-compatible endpoint
models.embedding.apiKey=
models.embedding.baseUrl=http://localhost:11434/v1
models.embedding.model=nomic-embed-text
models.embedding.dimensions=768

# RAG Pipeline Configuration
ragPipeline.ingestion.maxTokensPerChunk=512
ragPipeline.ingestion.concurrency=4
ragPipeline.ingestion.enrichmentConcurrency=4
ragPipeline.ingestion.embeddingConcurrency=4
# Note: excludePatterns are best managed in config/app.yaml due to complex regex syntax
# Image and video file extensions are now excluded in app.yaml
ragPipeline.retrieval.topK=10
ragPipeline.retrieval.vectorWeight=0.7
ragPipeline.retrieval.bm25Weight=0.3
